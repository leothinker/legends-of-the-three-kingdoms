{
  "extends": "../../tsconfig.json",
  "exclude": ["dist", "output", "node_modules"],
  "compilerOptions": {
    "lib": ["dom", "WebWorker", "ESNext"],
    "paths": {
      "@/*": ["./wtk/*"],
      "wtk": ["./wtk.js"]
    },
    "typeRoots": ["./typings", "./node_modules/@types"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "disableSizeLimit": true,
    "strictPropertyInitialization": false,
    "ignoreDeprecations": "5.0"
  }
}
