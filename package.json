{
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "serve": "pnpm -F @wtk/fs dev --dirname=../../dist",
    "start": "pnpm build && pnpm serve",
    "generateTestPack": "pnpm build && tsx scripts/generateTestPack.ts",
    "lint": "run-s lint:*",
